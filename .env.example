# Copy to .env and fill in your own values. .env is gitignored.

# --- Identity / branding (used by scripts/render-templates.sh and bootstrap scripts) ---
# CUSTOMER_NAME feeds: the OpenWebUI Knowledge collection name, the persona's
# skill content (rendered via scripts/render-templates.sh), and the bootstrap
# scripts' knowledge-collection lookup.
CUSTOMER_NAME=YourCustomer
PROJECT_NAME=your-project-name
# INDUSTRY is descriptive metadata only — surfaced in the model description
# and README, does not rewrite skill checklist content (that stays as
# Dutch-financial-services example content regardless of this value).
# Quote any value containing spaces (required for `source .env`, used by
# scripts/render-templates.sh and the bootstrap scripts).
INDUSTRY="Your Industry"

# --- Obsidian vault (mounted read-only into mcpo and the ingestion service) ---
VAULT_HOST_PATH=/path/to/your/obsidian/vault

# --- Ollama (binary on host, not containerised) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Vector store: switch from default (sqlite) to chromadb ---
VECTOR_DB=chroma
CHROMA_HTTP_HOST=chromadb
CHROMA_HTTP_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# --- RAG web search via local SearXNG (no data leaves the machine) ---
# ENABLE_RAG_WEB_SEARCH bootstraps the feature on first launch.
# WEB_SEARCH_ENGINE and SEARXNG_QUERY_URL are database-backed — manage via
# Admin Panel → Settings → Web Search or the /api/v1/configs/rag API endpoint.
ENABLE_RAG_WEB_SEARCH=true

# --- Secrets are provided via Docker secrets (./secrets/*), not this file ---
# See secrets/README.md.
