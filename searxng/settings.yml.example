# SearXNG settings - see https://docs.searxng.org/admin/settings/settings.html
#
# Copy this to settings.yml (gitignored) and replace secret_key with your own:
#   cp searxng/settings.yml.example searxng/settings.yml
#   sed -i '' "s/CHANGE_ME/$(openssl rand -hex 32)/" searxng/settings.yml

use_default_settings: true

server:
  secret_key: "CHANGE_ME"
  limiter: false
  image_proxy: true
  port: 8080
  bind_address: "0.0.0.0"

ui:
  static_use_hash: true

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "auto"
  formats:
    - html
    - json
